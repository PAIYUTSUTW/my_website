---
import Base from '../layouts/Base.astro';
import PublicationList from '../components/PublicationList.astro';
import Arrow from '../components/Arrow.astro';
import { profile } from '../data/profile';
---
<Base title="Publications">
  <section class="page-heading container"><span class="eyebrow">PUBLICATIONS</span><h1>Questions explored.<br /><em>Findings shared.</em></h1><p>Selected work on security automation, LLM evaluation, vulnerability repair, and applied machine learning.</p><a class="text-link" href={profile.links[0].url} target="_blank" rel="noreferrer">Google Scholar<Arrow diagonal /></a></section>
  <section class="container publications-content" aria-label="Publication list"><PublicationList detailed /></section>
</Base>
