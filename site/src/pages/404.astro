---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { path } from '../data/profile';
---
<Base title="Page not found"><section class="page-heading container not-found"><span class="eyebrow">404 / PAGE NOT FOUND</span><h1>A missing link.<br /><em>A new direction.</em></h1><p>This page may have moved as the site evolved. Explore my current research or return to the homepage.</p><a class="button primary" href={path('/')}>Back to home<Arrow /></a></section></Base>
