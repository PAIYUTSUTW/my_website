---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import ResearchFocus from '../components/ResearchFocus.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PublicationList from '../components/PublicationList.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/profile.png';
import { profile, currentResearch, publications, experience, path } from '../data/profile';
---
<Base>
  <section class="hero container">
    <div class="hero-copy">
      <div class="hero-kicker"><span class="status-dot"></span> PEI-YU (JERRY) TSENG / PENN STATE</div>
      <h1>AI agents for<br /><em>security<br />operations.</em></h1>
      <p class="hero-intro">I’m <strong>Pei-Yu (Jerry) Tseng</strong>, a Ph.D. candidate at Penn State. I build AI agents for security automation, from generated test environments to benchmarks for training small models to write playbooks.</p>
      <div class="hero-actions"><a class="button primary" href={path('/portfolio/')}>Explore my research<Arrow /></a><a class="text-link" href={path('/cv/')}>View CV<Arrow diagonal /></a></div>
      <div class="hero-affiliation"><span class="affiliation-icon">⌘</span><div>Penn State University<span>Informatics · Advised by Prof. Peng Liu</span></div></div>
    </div>
    <ResearchFocus />
  </section>
  <section class="section container" id="research">
    <div class="section-header"><div><span class="eyebrow">01 / CURRENT RESEARCH</span><h2>Test environments.<br /><em>Small models for playbooks.</em></h2></div><a class="text-link" href={path('/portfolio/')}>All research<Arrow /></a></div>
    <div class="project-grid">{currentResearch.map(project => <ProjectCard project={project} />)}</div>
  </section>
  <section class="about-band" id="about"><div class="container about-grid"><div class="portrait-wrap"><Image src={portrait} alt="Pei-Yu Tseng" width={420} height={500} fit="cover" format="webp" loading="lazy" /><div class="portrait-caption"><span>PEI-YU / JERRY</span><span>RESEARCHER & BUILDER</span></div></div><div class="about-copy"><span class="eyebrow">02 / ABOUT ME</span><h2>From threat intelligence<br /><em>to security automation.</em></h2><p>{profile.about}</p><p>{profile.background}</p><div class="about-links"><a class="text-link" href={path('/portfolio/')}>Current research<Arrow /></a><a class="text-link" href={path('/cv/')}>CV & experience<Arrow /></a><a class="text-link" href={profile.links[2].url} target="_blank" rel="noreferrer">LinkedIn<Arrow diagonal /></a></div></div></div></section>
  <section class="section container">
    <div class="section-header"><div><span class="eyebrow">03 / SELECTED PUBLICATIONS</span><h2>Selected <em>publications.</em></h2></div><a class="text-link" href={path('/publications/')}>All publications<Arrow /></a></div>
    <PublicationList items={publications.slice(0, 3)} />
  </section>
  <section class="section experience-section container"><div class="section-header"><div><span class="eyebrow">04 / EXPERIENCE</span><h2>Research & <em>experience.</em></h2></div><a class="text-link" href={path('/cv/')}>Full CV<Arrow /></a></div><div class="experience-list">{experience.slice(0, 2).map(item => <div class="experience-row"><span class="experience-date">{item.date}</span><div><h3>{item.institution}</h3><p>{item.role}</p></div><span class="experience-location">{item.location}</span></div>)}</div></section>
</Base>

<style>
  .about-links{flex-wrap:wrap;row-gap:15px}
</style>
