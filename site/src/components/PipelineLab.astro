---
import { pipelineStages } from '../data/pipelineDemo';
import { path } from '../data/profile';
---
<section class="pipeline-lab" id="concept-demo" aria-labelledby="lab-heading" data-phase="after" data-playing="false" data-rebuilding="false" data-effects="paused">
  <div class="lab-intro">
    <span class="eyebrow">PIPELINE1 / THE CORE IDEA</span>
    <h2 id="lab-heading">Real service → <em>software mock.</em></h2>
    <p>Our agents generate the replacement: a low-cost, disposable software environment for testing LLM-generated playbooks.</p>
  </div>
  <div class="lab-comparison">
    <svg class="lab-beams" aria-hidden="true" focusable="false"></svg>
    <div class="lab-route lab-before" role="group" aria-label="Before: connect to a real service">
      <div class="lab-route-label"><span>BEFORE</span><p>Connect to the real service</p></div>
      <div class="lab-route-flow">
        <div class="lab-node lab-playbook"><span class="lab-node-icon" aria-hidden="true">☷</span><h3>LLM-generated playbook</h3></div>
        <div class="lab-wire" aria-hidden="true"><i></i></div>
        <div class="lab-node lab-connector"><span class="lab-node-icon" aria-hidden="true">↗</span><h3>SOAR + real connector</h3></div>
        <div class="lab-wire" aria-hidden="true"><i></i></div>
        <div class="lab-node lab-service"><div class="lab-server-icon" aria-hidden="true"><i></i><i></i><i></i></div><h3>Real service</h3><p>Access, deploy, maintain.</p></div>
      </div>
      <p class="lab-cost">Service access and VM-based test deployments add setup, resource, and maintenance costs.</p>
    </div>
    <div class="lab-replacement-label"><span aria-hidden="true">↓</span> Replace the service dependency</div>
    <div class="lab-route lab-after" role="group" aria-label="With Pipeline1: connect to an agent-generated software mock">
      <div class="lab-route-label"><span>WITH PIPELINE1</span><p>Connect to a generated mock</p></div>
      <div class="lab-route-flow">
        <div class="lab-node lab-playbook"><span class="lab-node-icon" aria-hidden="true">☷</span><h3>Same playbook</h3></div>
        <div class="lab-wire" aria-hidden="true"><i></i></div>
        <div class="lab-node lab-connector"><span class="lab-node-icon" aria-hidden="true">↗</span><h3>Same SOAR + real connector</h3></div>
        <div class="lab-wire" aria-hidden="true"><i></i></div>
        <div class="lab-node lab-mock">
          <div class="lab-mock-content"><div class="lab-code-icon" aria-hidden="true">{'{ }'}</div><h3>Software-defined mock environment</h3><p>Simulated responses + state</p></div>
          <span class="lab-instance" data-instance>MOCK 01</span>
        </div>
      </div>
      <div class="lab-benefits"><span>Low-cost by design</span><span>Disposable</span><span>Quick to recreate</span></div>
    </div>
    <div class="lab-generation" role="group" aria-label="Pipeline1 agents generate the mock from connector source and documentation">
      <div class="lab-generation-input"><span class="lab-micro-label">INPUT</span><p>Connector source<br />& documentation</p></div>
      <div class="lab-build-wire" aria-hidden="true"><i></i><span>read</span></div>
      <div class="lab-agent"><span class="lab-agent-icon" aria-hidden="true">✳</span><div><span class="lab-micro-label">OUR AUTOMATION</span><h3>Pipeline1 agent</h3></div></div>
      <div class="lab-build-wire lab-output-wire" aria-hidden="true"><i></i><span>generates</span></div>
      <div class="lab-generation-output"><span aria-hidden="true">↑</span><p>the software mock<br /><strong>shown above</strong></p></div>
    </div>
  </div>
  <div class="lab-controls" hidden>
    <div class="lab-toolbar">
      <div class="lab-views" role="group" aria-label="Compare service destinations"><button type="button" data-view="before" aria-pressed="false">Before</button><button type="button" data-view="after" aria-pressed="true">With Pipeline1</button></div>
      <button type="button" class="lab-play" data-play><span data-play-icon aria-hidden="true">▶</span><span data-play-label>Watch the replacement</span></button>
      <button type="button" class="lab-rebuild" data-rebuild>↻ Discard & rebuild mock</button>
    </div>
    <p class="lab-status" aria-live="polite" aria-atomic="true" data-status>{pipelineStages[2].description}</p>
    <p class="lab-motion-note" hidden>Reduced motion is on. Use Before / With Pipeline1 to compare.</p>
  </div>
  <div class="lab-footnote"><p>Concept illustration. Lower cost and faster rebuilding are design goals.</p><button type="button" class="lab-effects" data-effects-toggle hidden>Pause light effects</button><a href={path('/pipeline1-concept.svg')} download>Download the diagram <span aria-hidden="true">↗</span></a></div>
</section>

<script>
  import { pipelineStages } from '../data/pipelineDemo';
  const lab = document.querySelector<HTMLElement>('.pipeline-lab');
  if (lab) {
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    const views = lab.querySelectorAll<HTMLButtonElement>('[data-view]');
    const play = lab.querySelector<HTMLButtonElement>('[data-play]')!;
    const rebuild = lab.querySelector<HTMLButtonElement>('[data-rebuild]')!;
    const status = lab.querySelector<HTMLElement>('[data-status]')!;
    const effectsButton = lab.querySelector<HTMLButtonElement>('[data-effects-toggle]')!;
    const comparison = lab.querySelector<HTMLElement>('.lab-comparison')!;
    const beams = lab.querySelector<SVGSVGElement>('.lab-beams')!;
    let effectsPaused = false, inView = false;
    const syncEffects = () => {
      lab.dataset.effects = !effectsPaused && inView && !motion.matches && !document.hidden ? 'running' : 'paused';
      effectsButton.textContent = effectsPaused ? 'Resume light effects' : 'Pause light effects';
      effectsButton.hidden = motion.matches;
    };
    effectsButton.addEventListener('click', () => { effectsPaused = !effectsPaused; syncEffects(); });
    // Measure the actual nodes, including the stacked mobile layout. No fixed canvas coordinates.
    const drawBeams = () => {
      const bounds = comparison.getBoundingClientRect();
      const mobile = matchMedia('(max-width: 740px)').matches;
      beams.setAttribute('viewBox', `0 0 ${bounds.width} ${bounds.height}`);
      beams.replaceChildren();
      const box = (selector: string) => {
        const rect = comparison.querySelector(selector)!.getBoundingClientRect();
        return { left: rect.left - bounds.left, right: rect.right - bounds.left, top: rect.top - bounds.top, bottom: rect.bottom - bounds.top, x: rect.left - bounds.left + rect.width / 2, y: rect.top - bounds.top + rect.height / 2 };
      };
      const add = (d: string, kind: string) => {
        const group = document.createElementNS('http://www.w3.org/2000/svg', 'g');
        group.setAttribute('class', `beam-group beam-${kind}`);
        for (const name of ['beam-track', 'beam-light']) {
          const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
          path.setAttribute('d', d); path.setAttribute('class', name); path.setAttribute('pathLength', '100');
          group.append(path);
        }
        beams.append(group);
      };
      for (const route of ['before', 'after']) {
        const nodes = ['playbook', 'connector', route === 'before' ? 'service' : 'mock'];
        for (let i = 0; i < 2; i++) {
          const a = box(`.lab-${route} .lab-${nodes[i]}`), b = box(`.lab-${route} .lab-${nodes[i + 1]}`);
          add(mobile ? `M${a.x} ${a.bottom}L${b.x} ${b.top}` : `M${a.right} ${a.y}C${(a.right+b.left)/2} ${a.y} ${(a.right+b.left)/2} ${b.y} ${b.left} ${b.y}`, route);
        }
      }
      const input = box('.lab-generation-input'), agent = box('.lab-agent'), mock = box('.lab-mock');
      if (!mobile) add(`M${input.right} ${input.y}L${agent.left} ${agent.y}`, 'generation');
      // The agent's output goes directly into the mock, along the outer gutter.
      const gutter = bounds.width - (mobile ? 8 : 14), bend = 10, bottom = agent.bottom + 18;
      add(`M${agent.x} ${agent.bottom}V${bottom-bend}Q${agent.x} ${bottom} ${agent.x+bend} ${bottom}H${gutter-bend}Q${gutter} ${bottom} ${gutter} ${bottom-bend}V${mock.y+bend}Q${gutter} ${mock.y} ${gutter-bend} ${mock.y}H${mock.right}`, 'generation');
      lab.dataset.beams = 'ready';
    };
    new ResizeObserver(drawBeams).observe(comparison);
    document.fonts.ready.then(drawBeams);
    let stage = 2, instance = 1;
    let playing = false, rebuilding = false;
    let timer: ReturnType<typeof setTimeout> | undefined;
    let rebuildTimer: ReturnType<typeof setTimeout> | undefined;
    const render = () => {
      lab.dataset.phase = pipelineStages[stage].id;
      lab.dataset.playing = String(playing);
      lab.dataset.rebuilding = String(rebuilding);
      views.forEach(button => { button.setAttribute('aria-pressed', String(button.dataset.view === pipelineStages[stage].id)); button.disabled = rebuilding; });
      play.disabled = rebuilding;
      rebuild.disabled = stage !== 2 || playing || rebuilding;
      lab.querySelector('[data-play-label]')!.textContent = playing ? 'Pause animation' : stage === 2 ? 'Watch the replacement' : 'Continue animation';
      lab.querySelector('[data-play-icon]')!.textContent = playing ? 'Ⅱ' : '▶';
      lab.querySelector('[data-instance]')!.textContent = rebuilding ? 'REBUILDING…' : `MOCK ${String(instance).padStart(2, '0')}`;
      status.textContent = rebuilding ? 'Discarding the used mock. Creating a fresh software environment.' : instance > 1 && stage === 2 ? `Mock ${String(instance).padStart(2, '0')} is ready. The playbook and connector stay the same; the real service is outside this test path.` : pipelineStages[stage].description;
    };
    const pause = () => { clearTimeout(timer); playing = false; render(); status.setAttribute('aria-live', 'polite'); };
    const schedule = () => { timer = setTimeout(() => { if (!playing) return; stage++; if (stage === 2) { pause(); return; } render(); schedule(); }, 2600); };
    views.forEach(button => button.addEventListener('click', () => { stage = button.dataset.view === 'before' ? 0 : 2; pause(); }));
    play.addEventListener('click', () => {
      if (playing) { pause(); return; }
      if (motion.matches) return;
      if (stage === 2) stage = 0;
      playing = true; status.setAttribute('aria-live', 'off'); render(); schedule();
    });
    rebuild.addEventListener('click', () => {
      if (rebuilding || stage !== 2) return;
      rebuilding = true; render();
      rebuildTimer = setTimeout(() => { instance++; rebuilding = false; render(); }, motion.matches ? 0 : 850);
    });
    const updateMotion = () => {
      pause();
      syncEffects();
      if (motion.matches && rebuilding) { clearTimeout(rebuildTimer); instance++; rebuilding = false; render(); }
      play.hidden = motion.matches;
      lab.querySelector<HTMLElement>('.lab-motion-note')!.hidden = !motion.matches;
    };
    motion.addEventListener('change', updateMotion);
    document.addEventListener('visibilitychange', () => { if (document.hidden) pause(); syncEffects(); });
    new IntersectionObserver(entries => { inView = entries[0].isIntersecting; if (!inView && playing) pause(); syncEffects(); }).observe(lab);
    lab.querySelector<HTMLElement>('.lab-controls')!.hidden = false;
    updateMotion();
  }
</script>

<style>
  .pipeline-lab{--lab-real:#e7b990;--lab-real-bg:#282119;--lab-mock-bg:#1b2614;--lab-blue:#a0d8e3;border:1px solid var(--line);border-radius:10px;overflow:hidden;background:var(--surface-soft);scroll-margin-top:115px}
  :global([data-theme=light]) .pipeline-lab{--lab-real:#7d4c21;--lab-real-bg:#f2e7d9;--lab-mock-bg:#e2ecd7;--lab-blue:#285e6c}
  .lab-intro{padding:32px 34px 27px;border-bottom:1px solid var(--line)}.lab-intro .eyebrow{color:var(--accent);font-size:9px;margin-bottom:14px}.lab-intro h2{font-size:39px;line-height:1.2}.lab-intro h2 em{color:var(--accent)}.lab-intro>p{font-size:14px;color:var(--muted);max-width:750px;margin-top:14px;line-height:1.8}
  .lab-comparison{padding:26px 30px 24px;background-image:radial-gradient(var(--line) .7px,transparent .7px);background-size:20px 20px}.lab-route{border:1px solid var(--line);border-radius:6px;background:var(--bg);padding:18px 22px}.lab-route-label{display:flex;gap:16px;align-items:center;margin-bottom:16px}.lab-route-label>span{font-size:10px;letter-spacing:.1em;font-weight:700;color:var(--muted);min-width:110px}.lab-route-label>p{font-size:12px;color:var(--muted)}.lab-route-flow{display:grid;grid-template-columns:1fr 55px 1.1fr 55px 1.6fr;align-items:center}.lab-node{min-width:0;border:1px solid var(--line);border-radius:5px;padding:17px 18px;background:var(--surface-soft);min-height:120px;display:flex;align-items:center;gap:13px}.lab-node h3{font-size:18px;letter-spacing:-.035em;line-height:1.35}.lab-node-icon{font-size:25px;line-height:1;color:var(--muted)}.lab-wire{height:1px;background:var(--line);position:relative}.lab-wire:after{content:'';width:6px;height:6px;position:absolute;right:1px;top:-3px;border-top:1px solid var(--muted);border-right:1px solid var(--muted);transform:rotate(45deg)}.lab-wire i{position:absolute;width:5px;height:5px;border-radius:50%;background:var(--accent);top:-2px;left:0;opacity:0}.lab-service{display:grid;grid-template-columns:38px 1fr;column-gap:15px;row-gap:2px;background:var(--lab-real-bg);border-color:var(--lab-real)}.lab-service h3{font-size:23px;color:var(--lab-real)}.lab-service p{grid-column:2;font-size:11px;color:var(--muted)}.lab-server-icon{grid-row:1/3;display:grid;gap:5px;width:38px}.lab-server-icon i{height:12px;border:1px solid var(--lab-real);border-radius:2px;position:relative}.lab-server-icon i:before{content:'';width:3px;height:3px;background:var(--lab-real);position:absolute;top:3px;left:4px}.lab-cost{font-size:11px;color:var(--muted);margin-top:13px}.lab-replacement-label{display:flex;gap:12px;align-items:center;justify-content:flex-end;padding:12px 25px;color:var(--accent);font-size:11px}.lab-replacement-label>span{font-size:21px;line-height:1}.lab-after .lab-route-label>span{color:var(--accent)}.lab-mock{display:block;position:relative;background:var(--lab-mock-bg);border:1px dashed var(--accent);padding-right:12px}.lab-mock-content{display:grid;grid-template-columns:44px 1fr;column-gap:12px;align-items:center}.lab-code-icon{grid-row:1/3;font-family:monospace;font-size:26px;letter-spacing:-.15em;color:var(--accent)}.lab-mock h3{font-size:20px;color:var(--accent);line-height:1.25}.lab-mock p{grid-column:2;font-size:10px;color:var(--muted);margin-top:7px}.lab-instance{position:absolute;right:9px;top:5px;font-family:monospace;font-size:8px;color:var(--accent)}.lab-benefits{display:flex;gap:7px;justify-content:flex-end;margin-top:13px;flex-wrap:wrap}.lab-benefits span{font-size:10px;line-height:1.4;border:1px solid var(--line);border-radius:3px;padding:5px 8px;color:var(--text)}
  .lab-generation{display:grid;grid-template-columns:1fr 45px 1.1fr 70px 1.6fr;gap:0;align-items:center;padding:25px 23px 0}.lab-micro-label{display:block;font-size:8px;letter-spacing:.12em;color:var(--muted);font-weight:650;margin-bottom:5px}.lab-generation-input p{font-size:11px;line-height:1.7;color:var(--text)}.lab-agent{display:flex;align-items:center;gap:12px;border:1px solid var(--lab-blue);padding:17px 13px;border-radius:5px;background:var(--bg)}.lab-agent-icon{font-size:27px;line-height:1;color:var(--lab-blue)}.lab-agent h3{font-size:19px;line-height:1.25;letter-spacing:-.04em}.lab-agent .lab-micro-label{font-size:7px;color:var(--lab-blue)}.lab-build-wire{height:1px;background:var(--line);position:relative}.lab-build-wire:after{content:'';position:absolute;right:0;top:-3px;width:6px;height:6px;border-top:1px solid var(--lab-blue);border-right:1px solid var(--lab-blue);transform:rotate(45deg)}.lab-build-wire>span{font-size:9px;position:absolute;left:50%;top:-22px;transform:translateX(-50%);color:var(--muted);background:var(--surface-soft);padding:2px 4px;white-space:nowrap}.lab-build-wire i{position:absolute;left:0;top:-2px;width:5px;height:5px;background:var(--lab-blue);border-radius:50%;opacity:0}.lab-generation-output{display:flex;gap:12px;align-items:center;justify-content:center}.lab-generation-output>span{font-size:32px;color:var(--accent)}.lab-generation-output p{font-size:12px;line-height:1.7}.lab-generation-output strong{color:var(--accent);font-weight:500}
  .lab-controls{padding:19px 32px;border-top:1px solid var(--line);background:var(--bg)}.lab-toolbar{display:flex;gap:22px;align-items:center;flex-wrap:wrap}.lab-views{display:flex;border:1px solid var(--line);border-radius:5px;padding:3px;gap:3px}.lab-views button{border:0;background:transparent;color:var(--muted);border-radius:3px;font-size:11px;padding:8px 12px}.lab-views button[aria-pressed=true]{background:var(--accent);color:var(--ink)}.lab-play,.lab-rebuild{background:transparent;border:0;color:var(--text);padding:9px 0;font-size:11px;line-height:1.5}.lab-play{display:flex;gap:9px;align-items:center}.lab-play>span:first-child{color:var(--accent)}.lab-rebuild{margin-left:auto;color:var(--accent)}.lab-toolbar button:disabled{opacity:.55;cursor:default}.lab-status{margin-top:16px;font-size:12px;color:var(--text);min-height:42px;line-height:1.8;max-width:820px}.lab-motion-note{font-size:10px;color:var(--muted);margin-top:8px}.lab-footnote{padding:14px 32px;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:20px;font-size:10px;line-height:1.7;color:var(--muted)}.lab-footnote a{color:var(--text);text-decoration:underline;text-underline-offset:4px;flex-shrink:0}
  [data-phase=before] .lab-before{border-color:var(--lab-real)}[data-phase=before] .lab-before .lab-wire{background:var(--lab-real)}[data-phase=before] .lab-before .lab-wire:after{border-color:var(--lab-real)}[data-phase=after] .lab-after{border-color:var(--accent)}[data-phase=after] .lab-after .lab-wire{background:var(--accent)}[data-phase=after] .lab-after .lab-wire:after{border-color:var(--accent)}[data-phase=generate] .lab-agent{box-shadow:0 0 24px color-mix(in srgb,var(--lab-blue) 18%,transparent)}[data-phase=generate] .lab-mock-content{animation:lab-materialize .85s ease both}[data-phase=generate][data-playing=true] .lab-build-wire i{opacity:1;animation:lab-packet 1s linear infinite}[data-phase=before][data-playing=true] .lab-before .lab-wire i{background:var(--lab-real);opacity:1;animation:lab-packet 1s linear infinite}[data-rebuilding=true] .lab-mock-content{animation:lab-rebuild .85s ease both}
  @keyframes lab-packet{from{left:0}to{left:100%}}@keyframes lab-materialize{from{opacity:.1;transform:translateY(9px)}to{opacity:1;transform:translateY(0)}}@keyframes lab-rebuild{0%{opacity:1;transform:scale(1)}40%{opacity:0;transform:scale(.88)}55%{opacity:0;transform:scale(1.06)}100%{opacity:1;transform:scale(1)}}
  @media(max-width:1100px){.lab-comparison{padding:23px}.lab-route{padding:16px}.lab-route-flow{grid-template-columns:1fr 28px 1.1fr 28px 1.6fr}.lab-node{padding:14px 12px;gap:9px}.lab-node h3{font-size:16px}.lab-node-icon{font-size:21px}.lab-service{column-gap:10px;grid-template-columns:29px 1fr}.lab-server-icon{width:29px}.lab-service h3{font-size:21px}.lab-mock-content{grid-template-columns:32px 1fr;column-gap:8px}.lab-code-icon{font-size:22px}.lab-mock h3{font-size:18px}.lab-generation{grid-template-columns:1fr 28px 1.1fr 50px 1.6fr;padding-inline:17px}.lab-agent{gap:8px;padding:14px 9px}.lab-agent h3{font-size:16px}.lab-agent-icon{font-size:22px}.lab-toolbar{gap:14px}.lab-intro h2{font-size:35px}}
  @media(max-width:740px){.lab-intro{padding:25px 22px}.lab-intro h2{font-size:31px}.lab-intro>p{font-size:13px}.lab-comparison{padding:18px}.lab-route{padding:16px}.lab-route-label{align-items:flex-start;gap:5px;flex-direction:column;margin-bottom:15px}.lab-route-label>span{font-size:9px}.lab-route-label>p{font-size:11px}.lab-route-flow{grid-template-columns:1fr;gap:0}.lab-node{min-height:0;padding:12px 15px;justify-content:center}.lab-node h3{font-size:16px;text-align:center}.lab-node-icon{font-size:20px}.lab-wire{height:19px;width:1px;justify-self:center}.lab-wire:after{right:-3px;top:auto;bottom:2px;transform:rotate(135deg)}.lab-wire i{display:none}.lab-service{display:grid;grid-template-columns:29px auto;column-gap:13px;justify-content:center;padding:17px}.lab-service h3{text-align:left;font-size:23px}.lab-service p{font-size:10px}.lab-cost{font-size:10px;line-height:1.8;margin-top:12px}.lab-replacement-label{padding:10px 0;justify-content:center;font-size:10px}.lab-mock{padding:21px 14px 15px;min-height:104px}.lab-mock-content{grid-template-columns:30px auto;justify-content:center;column-gap:12px}.lab-mock h3{font-size:20px;text-align:left}.lab-mock p{font-size:10px}.lab-benefits{justify-content:center;gap:5px;margin-top:12px}.lab-benefits span{font-size:9px;padding:4px 6px}.lab-generation{grid-template-columns:1fr 1fr;gap:13px;padding:19px 0 0}.lab-generation-input{grid-column:1;font-size:10px}.lab-generation-input p{font-size:10px}.lab-build-wire{display:none}.lab-agent{grid-column:2;grid-row:1;gap:7px;padding:13px 10px}.lab-agent h3{font-size:17px}.lab-agent-icon{display:none}.lab-agent .lab-micro-label{font-size:7px}.lab-generation-input:after{content:'read by →';font-size:10px;color:var(--lab-blue);display:block;margin-top:5px}.lab-generation-output{grid-column:1/-1;justify-content:center;border-top:1px solid var(--line);padding-top:12px}.lab-generation-output p{font-size:11px}.lab-generation-output p:before{content:'Agent generates ';color:var(--lab-blue)}.lab-generation-output strong{font-weight:500}.lab-generation-output>span{font-size:25px}.lab-controls{padding:18px}.lab-toolbar{gap:12px;justify-content:space-between}.lab-views{width:100%;justify-content:center}.lab-views button{flex:1;font-size:11px}.lab-play,.lab-rebuild{font-size:10px}.lab-rebuild{margin-left:0}.lab-status{font-size:11px;min-height:64px;margin-top:13px}.lab-footnote{padding:14px 20px;flex-direction:column;gap:8px}.lab-motion-note{font-size:10px}}
  @media print{.lab-controls,.lab-footnote a{display:none}.lab-comparison{background:none}.lab-route,.lab-generation{break-inside:avoid}.pipeline-lab{--lab-real:#555;--lab-real-bg:#eee;--lab-mock-bg:#eee;--lab-blue:#333}.lab-intro h2{font-size:28px}}
  /* Beam paths use measured node positions, including the stacked mobile layout. */
  .lab-comparison{position:relative;isolation:isolate}
  .lab-beams{position:absolute;inset:0;width:100%;height:100%;z-index:2;pointer-events:none;overflow:visible}
  .lab-beams :global(.beam-group){fill:none;stroke:var(--accent);stroke-linecap:round;stroke-linejoin:round}
  .lab-beams :global(.beam-before){stroke:var(--lab-real)}
  .lab-beams :global(.beam-generation){stroke:var(--lab-blue)}
  .lab-beams :global(.beam-track){stroke-width:1;opacity:.35}
  .lab-beams :global(.beam-light){stroke-width:2;stroke-dasharray:14 86;stroke-dashoffset:100;animation:lab-beam-flow 3s linear infinite;filter:drop-shadow(0 0 4px var(--accent));opacity:0}
