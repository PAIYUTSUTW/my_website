---
interface Props { variant: string; }
const { variant } = Astro.props;
---
<div class:list={['project-art', `art-${variant}`]} aria-hidden="true">
  {variant === 'benchmark' ? <><div class="benchmark-art"><span>SCENARIOS + SCORING</span><span>↓</span><div><strong>Small model</strong><span>→</span><strong>Playbook</strong></div></div><span class="art-caption">BENCHMARK · TRAIN · EVALUATE</span></> : variant === 'environment' ? <><div class="environment-art"><span>AI AGENT</span><span aria-hidden="true">↓</span><strong>Test environment</strong><span>generate · test · recreate</span></div><span class="art-caption">A PLACE TO TEST SECURITY WORKFLOWS</span></> : variant === 'state' ? <><div class="state-diagram"><div class="mini-node">ACTION<span>revoke access</span></div><div class="diagram-line"></div><div class="state-pair"><span>before<i>active</i></span><span>after<i>revoked</i></span></div></div><span class="art-caption">OBSERVE THE CHANGE</span></> : variant === 'workflow' ? <><div class="workflow-diagram"><div class="flow-dot"></div><div class="flow-line"></div><div class="flow-block">intent</div><div class="flow-line"></div><div class="flow-block flow-diamond"><span>check</span></div><div class="flow-line"></div><div class="flow-block">action</div></div><span class="art-caption">PRESERVE THE OBJECTIVE</span></> : variant === 'regex' ? <><div class="regex-code"><span class="code-comment">// from indicator to pattern</span><span><i>^</i>…<b>(?:</b>context<b>)</b><i>.*</i></span><span class="code-under">extract <em>→</em> generate <em>→</em> validate</span></div><span class="art-caption">GROUND THE DETECTION</span></> : <><div class="eval-diagram"><span>human</span><div class="eval-circle circle-a"></div><div class="eval-circle circle-b"></div><span>model</span></div><span class="art-caption">EXAMINE THE AGREEMENT</span></>}
</div>

<style>
  .benchmark-art{display:flex;flex-direction:column;align-items:center;gap:14px;color:var(--accent)}.benchmark-art>span{font:10px monospace;letter-spacing:.08em}.benchmark-art>span:nth-child(2){font-size:20px;line-height:1}.benchmark-art>div{display:flex;align-items:center;gap:13px}.benchmark-art strong{background:var(--bg);border:1px solid color-mix(in srgb,var(--accent) 40%,var(--line));border-radius:10px;padding:14px 18px;font-size:14px;font-weight:500}

  .environment-art{display:flex;flex-direction:column;align-items:center;gap:9px}.environment-art>span{font:10px monospace;color:var(--muted);letter-spacing:.05em}.environment-art>span:nth-child(2){color:var(--accent);font-size:21px;line-height:1}.environment-art strong{border:1px solid color-mix(in srgb,var(--accent) 50%,var(--line));border-radius:10px;background:var(--bg);padding:15px 28px;color:var(--accent);font-size:18px;font-weight:500}.environment-art>span:last-child{font-size:9px;margin-top:3px}
</style>
