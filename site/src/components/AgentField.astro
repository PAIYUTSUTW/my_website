<div class="agent-field">
  <div class="field-top"><span class="eyebrow">THE RESEARCH LOOP</span><span class="field-coordinate">01 / 03</span></div>
  <div class="field-visual" aria-hidden="true">
    <div class="field-grid"></div>
    <canvas id="agent-canvas"></canvas>
    <span class="field-label label-context"><i></i>CONTEXT</span>
    <span class="field-label label-action"><i></i>ACTION</span>
    <span class="field-label label-evidence"><i></i>EVIDENCE</span>
    <span class="field-cross cross-one">+</span><span class="field-cross cross-two">+</span>
  </div>
  <div class="field-controls" role="group" aria-label="Explore the research loop">
    <button class="field-step active" type="button" aria-pressed="true" data-stage="0"><span>01</span> Ground</button>
    <button class="field-step" type="button" aria-pressed="false" data-stage="1"><span>02</span> Act</button>
    <button class="field-step" type="button" aria-pressed="false" data-stage="2"><span>03</span> Evaluate</button>
  </div>
  <p class="field-caption" aria-live="polite">Connect decisions to the right context.</p>
  <span class="field-note">A conceptual view of my research</span>
</div>
<script>
  const canvas = document.querySelector<HTMLCanvasElement>('#agent-canvas');
  const ctx = canvas?.getContext('2d');
  const media = window.matchMedia('(prefers-reduced-motion: reduce)');
  let stage = 0, rotation = 0, frame = 0, visible = true;
  if (canvas && ctx) {
    const colors = ['#c8f879', '#82cbd7', '#c1afff'];
    const captions = ['Connect decisions to the right context.', 'Translate security objectives into tool use.', 'Inspect outcomes, not just model outputs.'];
    let width = 500, height = 400;
    const resize = () => { const rect = canvas.getBoundingClientRect(); width = rect.width; height = rect.height; const dpr = Math.min(window.devicePixelRatio || 1, 2); canvas.width = width * dpr; canvas.height = height * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0); draw(); };
    function project(x: number, y: number, z: number) {
      const a = rotation + 0.35, b = -0.35;
      const x1 = x * Math.cos(a) - z * Math.sin(a), z1 = x * Math.sin(a) + z * Math.cos(a);
      const y1 = y * Math.cos(b) - z1 * Math.sin(b), z2 = y * Math.sin(b) + z1 * Math.cos(b);
      const scale = Math.min(width, height) * 0.34;
      return { x: width / 2 + x1 * scale, y: height / 2 + y1 * scale, depth: z2 };
    }
    function draw() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);
      const color = document.documentElement.dataset.theme === 'light' ? ['#567526', '#397784', '#775f98'][stage] : colors[stage];
      for (let lat = 1; lat < 18; lat++) {
        const phi = lat / 18 * Math.PI;
        let previous: ReturnType<typeof project> | undefined;
        for (let lon = 0; lon <= 64; lon++) {
          const theta = lon / 64 * Math.PI * 2;
          const ripple = stage === 1 ? 1 + Math.sin(theta * 3 + phi * 3) * 0.085 : stage === 2 ? 1 + Math.cos(phi * 6) * 0.05 : 1;
          const p = project(Math.sin(phi) * Math.cos(theta) * ripple, Math.cos(phi) * ripple, Math.sin(phi) * Math.sin(theta) * ripple);
          if (previous) { ctx.beginPath(); ctx.moveTo(previous.x, previous.y); ctx.lineTo(p.x, p.y); ctx.strokeStyle = color; ctx.globalAlpha = 0.12 + (p.depth + 1) * 0.22; ctx.lineWidth = 0.7; ctx.stroke(); }
          if (lon % 4 === 0) { ctx.beginPath(); ctx.arc(p.x, p.y, p.depth > 0 ? 1.3 : 0.8, 0, Math.PI * 2); ctx.fillStyle = color; ctx.globalAlpha = 0.25 + (p.depth + 1) * 0.3; ctx.fill(); }
          previous = p;
        }
      }
      for (let lon = 0; lon < 24; lon++) {
        ctx.beginPath();
        for (let lat = 0; lat <= 40; lat++) { const phi = lat / 40 * Math.PI, theta = lon / 24 * Math.PI * 2; const p = project(Math.sin(phi) * Math.cos(theta), Math.cos(phi), Math.sin(phi) * Math.sin(theta)); lat ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y); }
        ctx.strokeStyle = color; ctx.globalAlpha = 0.1; ctx.lineWidth = 0.6; ctx.stroke();
      }
      ctx.globalAlpha = 1;
    }
    function animate() { if (!visible || document.hidden || media.matches) { frame = 0; return; } rotation += 0.002; draw(); frame = requestAnimationFrame(animate); }
    function updateAnimation() { if (frame) cancelAnimationFrame(frame); frame = 0; draw(); if (visible && !document.hidden && !media.matches) frame = requestAnimationFrame(animate); }
    document.querySelectorAll<HTMLButtonElement>('.field-step').forEach(button => button.addEventListener('click', () => {
      stage = Number(button.dataset.stage);
      document.querySelectorAll('.field-step').forEach(el => { el.classList.toggle('active', el === button); el.setAttribute('aria-pressed', String(el === button)); });
      const caption = document.querySelector('.field-caption'); if (caption) caption.textContent = captions[stage];
      const counter = document.querySelector('.field-coordinate'); if (counter) counter.textContent = `0${stage + 1} / 03`;
      draw();
    }));
    new ResizeObserver(resize).observe(canvas);
    new IntersectionObserver(entries => { visible = entries[0].isIntersecting; updateAnimation(); }).observe(canvas);
    document.addEventListener('visibilitychange', updateAnimation);
    media.addEventListener('change', updateAnimation);
    new MutationObserver(draw).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    resize();
  }
</script>
